PORT=4000
# Frontend origin allowed by CORS (comma-separated for several)
CORS_ORIGIN=http://localhost:5173

FABRIC_CHANNEL_NAME=mychannel
FABRIC_MSP_ID=Org1MSP
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
# Absolute path to the org1 crypto folder from fabric-samples/test-network, e.g.
# /home/<you>/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com
FABRIC_CRYPTO_PATH=
